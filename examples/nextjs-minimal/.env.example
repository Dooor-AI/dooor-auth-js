# Copy from the app's "Auth" tab in the Dooor dashboard.
# On the Dooor OS runtime these are injected into the container already.

NEXT_PUBLIC_DOOOR_AUTH_PUBLISHABLE_KEY=dor_pk_...
DOOOR_AUTH_APP_ID=app_...
DOOOR_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32-at-least-32-chars

# Optional: defaults to https://api.os.dooor.ai
# DOOOR_AUTH_ISSUER=https://api.os.dooor.ai
